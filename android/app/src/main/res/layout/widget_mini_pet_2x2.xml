<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@android:drawable/dialog_holo_light_frame" android:padding="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
        <ImageView android:id="@+id/widget_pet_image" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="현재 키우는 펫" />
        <TextView android:id="@+id/widget_pet_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="파트너 Lv.1" android:textColor="#40354D" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="8dp">
        <TextView android:id="@+id/widget_hunger" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="배고픔" android:textSize="10sp" android:textColor="#40354D" />
        <ProgressBar android:id="@+id/widget_hunger_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="80" />
        <TextView android:id="@+id/widget_energy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="에너지" android:textSize="10sp" android:textColor="#40354D" />
        <ProgressBar android:id="@+id/widget_energy_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="80" />
        <TextView android:id="@+id/widget_hygiene" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="청결도" android:textSize="10sp" android:textColor="#40354D" />
        <ProgressBar android:id="@+id/widget_hygiene_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="80" />
        <TextView android:id="@+id/widget_joy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="행복도" android:textSize="10sp" android:textColor="#40354D" />
        <ProgressBar android:id="@+id/widget_joy_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:max="100" android:progress="80" />
    </LinearLayout>
</LinearLayout>